{
  "name": "Bamboo Crane Maiden",
  "version": "2.0.0",
  "canvas": {
    "width": 1254,
    "height": 1254,
    "cameraLocked": true,
    "referenceAlignment": { "scale": 0.97, "translateX": 68, "translateY": 100 }
  },
  "art": {
    "runtimeTexture": "../assets/runtime/character-master-4k.png",
    "archiveTexture": "../exports/character-master-8k.png",
    "sourceStyle": "hand-painted anime watercolor and ink",
    "skinSoftening": 0.4,
    "referenceRgbThroughRegisteredAlpha": true
  },
  "drivers": {
    "modes": ["auto", "puppet", "mocap", "show"],
    "priority": ["keyboard-action", "timeline", "mocap", "gamepad", "auto", "secondary-physics"],
    "mocap": "local camera optical-motion mapping with external normalized mocap input API"
  },
  "parameters": {
    "head": ["headX", "headY", "headZ"],
    "body": ["bodyX", "bodyY", "bodyZ", "breath", "hipX", "hipY", "weightShift"],
    "arms": ["shoulderL", "shoulderR", "elbowL", "elbowR", "wristL", "wristR"],
    "legsFeet": ["kneeL", "kneeR", "footL", "footR"],
    "face": ["eyeOpenL", "eyeOpenR", "eyeBallX", "eyeBallY", "mouthOpen"]
  },
  "blink": {
    "periodSeconds": 1.52,
    "timingToleranceSeconds": 0.1,
    "closeSeconds": 0.078,
    "holdSeconds": 0.034,
    "openSeconds": 0.118,
    "upperLidDroopDegrees": 15,
    "lowerLidMicroMotionHz": 0.5
  },
  "hair": {
    "logicalStrandCount": 2048,
    "renderGroups": ["hairLeft", "hairRight", "hairTips"],
    "rootFixCoefficient": 0.95,
    "tipAmplitudeCentimeters": [8, 12],
    "wind": {
      "source": "point-behind-neck",
      "speedMetersPerSecond": 1.2,
      "turbulence": 0.06
    }
  },
  "clothing": {
    "anchorRigidity": 9.8,
    "elasticModulusGigapascals": 200,
    "secondaryPhysicsGroups": [
      "sleeveLeft", "sleeveRight", "hemLeft", "hemCenter", "hemRight", "ribbonUpper", "ribbonLower"
    ],
    "connectorUnderpaint": true
  },
  "feet": {
    "contactStates": true,
    "supportFootAnchors": true,
    "maximumVerifiedSlidePixels": 2
  },
  "interaction": {
    "keyboard": "WASD/QE/Z/X/C/V/1-4",
    "pointer": ["gaze", "directional wind drag", "petal catch", "crane response"],
    "gamepad": true,
    "timelineSeconds": 16
  },
  "limitations": [
    "The 2048 hair strands are logical sub-simulations grouped into rendered raster layers, not 2048 individually meshed vectors.",
    "The 8K asset is a Lanczos archival upscale; it does not invent native 8K brush detail.",
    "The local camera mode estimates optical motion for head and shoulders; external landmark trackers can use window.live2dControl.dispatchInput for higher-fidelity skeletal mocap.",
    "Cubism .cmo3 output is experimental and still requires final opening validation in the proprietary Cubism Editor 5."
  ]
}
