# Rebuildable large release artifacts (published as GitHub Release assets)
exports/bamboo-crane-maiden-live2d-delivery.zip
exports/character-master-8k.png
assets/runtime/character-master-4k.png

# Browser evidence frames; retain JSON reports and the contact sheet
exports/visual-acceptance/*.png
!exports/visual-acceptance/state-contact-sheet.png
exports/player-sim/*.png
exports/viewer-model.png
exports/viewer-reference.png

# Cubism authoring evidence is kept locally; reports remain trackable.
exports/cubism-*.png
exports/connector-*.png
exports/underpaint-*.png
exports/rhand-layer-*.png
exports/right-hand-artifact-*.png
exports/art-*-isolated.png
exports/artfoot*-isolated.png
exports/current-cubism-*.png
exports/desktop-current.png
exports/reference-raised-hand-detail.png

# Keep only the current official Editor document in Git. PSDs and historical
# checkpoints are reproducible/local working files and would add hundreds of MB.
model/cubism/*
!model/cubism/bamboo-crane-maiden-editor.cmo3
!model/cubism/runtime-mvp-v1/
!model/cubism/runtime-mvp-v1/**

# Cubism PSD layer renders are generated by tools/build_cubism_psd.py. The
# hand-authored underpaint source remains trackable.
assets/cubism/layers/
assets/cubism/body-underpaint-clean.png
assets/cubism/layer-manifest.json

